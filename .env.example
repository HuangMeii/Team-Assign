APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=26907
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
# Đường dẫn chứng chỉ CA (Aiven bắt buộc SSL). File ca.pem đặt trong database/certs/
MYSQL_ATTR_SSL_CA=database/certs/ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Kiểm duyệt ảnh (Cloud Vision node server — repo AI-Services, services/vision-8888)
VISION_MODERATION_URL=http://127.0.0.1:8888
VISION_PUBLIC_BASE_URL="${APP_URL}"

# Kiểm duyệt text (PhoBERT FastAPI — repo AI-Services, services/fraud-8889)
# mode: rules (mặc định, không gọi mạng) | model | hybrid (rule OR model)
TEXT_MODERATION_URL=http://127.0.0.1:8889
TEXT_MODERATION_MODE=rules

# Đường dẫn model trên đĩa (server Python đọc qua env)
# (ví dụ theo máy tác giả — thay bằng đường dẫn thực tế trên máy bạn)
TEXT_MODEL_DIR=G:\MyApp\laragon\www\AI-Services\phobert-negative-classifier
MODERATION_MODEL_DIR=G:\MyApp\laragon\www\AI-Services\chat_moderation_model

# Ngưỡng gắn cờ dùng CHUNG giữa PHP và 2 server Python 8889/8890.
# Server Python đọc file này qua env THRESHOLDS_FILE (không set ⇒ dùng
# AI-Services\config\thresholds.example.json). Sửa ngưỡng KHÔNG cần restart server Python.
THRESHOLDS_FILE=G:\MyApp\laragon\www\Team-Assign\violation-detection\config\thresholds.json

# Kiểm duyệt text xúc phạm / nội dung nhạy cảm (PhoBERT v2 — repo AI-Services: services/sensitive-8890/app.py)
# mode: rules (mặc định, không gọi mạng) | model | hybrid (rule OR model)
MODERATION_URL=http://127.0.0.1:8890
MODERATION_MODE=rules

# Chatbot trợ lý đề tài — provider chính: groq (chuẩn OpenAI) | gemini. Thiếu key ⇒ widget tự ẩn.
# CHATBOT_FALLBACKS=gemini ⇒ Groq lỗi/quá tải thì tự chuyển sang Gemini.
CHATBOT_PROVIDER=groq
CHATBOT_FALLBACKS=gemini
CHATBOT_TIMEOUT=30
CHATBOT_CONNECT_TIMEOUT=5
CHATBOT_RETRY=2
# Dòng miễn trừ hiện ở CUỐI mỗi câu trả lời của chatbot (để trống ⇒ không hiện).
# LƯU Ý: giá trị có khoảng trắng BẮT BUỘC đặt trong dấu ngoặc kép, nếu không Dotenv báo "The environment file is invalid!".
CHATBOT_DISCLAIMER="Nội dung này chỉ mang tính chất tham khảo, nếu vui lòng cân nhắc hoặc trao đổi với giảng viên phụ trách."

# Groq — free tier, KHÔNG cần thẻ: openai/gpt-oss-120b · gpt-oss-20b · qwen/qwen3.8-27b
# (30 req/phút · 1.000 req/ngày · 8K token/phút). Tạo key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b

# (Dự phòng) Gemini — key dạng AQ... chỉ dùng được model mới: gemini-3.6-flash / gemini-flash-latest
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent

# Gợi ý đề tài theo NGỮ NGHĨA (AI-Services/services/topic-recommender-8891, port 8891) — semantic search.
# Sinh viên nhập mô tả → Top 5 đề tài gần nghĩa nhất trong lớp (cosine similarity).
# Vector đề tài lưu ở bảng topic_embeddings ⇒ mỗi đề tài chỉ embedding 1 lần.
# enabled=false ⇒ panel gợi ý tự báo "tạm thời không khả dụng", app vẫn chạy bình thường.
TOPIC_RECOMMENDER_ENABLED=true
TOPIC_RECOMMENDER_URL=http://127.0.0.1:8891
TOPIC_RECOMMENDER_MODEL_TAG=vietnamese-sbert
TOPIC_RECOMMENDER_TOP_K=5
TOPIC_RECOMMENDER_MIN_SCORE=0.0
TOPIC_RECOMMENDER_MAX_CANDIDATES=500
TOPIC_RECOMMENDER_TIMEOUT=15
TOPIC_RECOMMENDER_EMBED_TIMEOUT=120
RECOMMENDER_MODEL_DIR=G:\MyApp\laragon\www\AI-Services\services\topic-recommender-8891\model
