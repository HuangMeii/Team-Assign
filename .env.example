APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=26907
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
# Đường dẫn chứng chỉ CA (Aiven bắt buộc SSL). File ca.pem đặt trong database/certs/
MYSQL_ATTR_SSL_CA=database/certs/ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Kiểm duyệt ảnh (Cloud Vision node server, project ImageCommentClassification)
VISION_MODERATION_URL=http://127.0.0.1:8888
VISION_PUBLIC_BASE_URL="${APP_URL}"

# Kiểm duyệt text (PhoBERT FastAPI, violation-detection/python/app.py)
# mode: rules (mặc định, không gọi mạng) | model | hybrid (rule OR model)
TEXT_MODERATION_URL=http://127.0.0.1:8889
TEXT_MODERATION_MODE=rules

# Đường dẫn model trên đĩa (server Python đọc qua env)
TEXT_MODEL_DIR=G:\MyApp\laragon\www\AI-Services\phobert-negative-classifier
MODERATION_MODEL_DIR=G:\MyApp\laragon\www\AI-Services\chat_moderation_model

# Kiểm duyệt text xúc phạm / nội dung nhạy cảm (PhoBERT v2, app_moderation.py)
# mode: rules (mặc định, không gọi mạng) | model | hybrid (rule OR model)
MODERATION_URL=http://127.0.0.1:8890
MODERATION_MODE=rules

# Chatbot trợ lý đề tài (Gemini) — thiếu key thì chatbot tự ẩn
# Key mới (dạng AQ...) chỉ dùng được model mới: gemini-3.6-flash / gemini-3.5-flash / gemini-flash-latest
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent

# Gợi ý đề tài theo NGỮ NGHĨA (AI-Services/topic-recommender, port 8891) — semantic search.
# Sinh viên nhập mô tả → Top 5 đề tài gần nghĩa nhất trong lớp (cosine similarity).
# Vector đề tài lưu ở bảng topic_embeddings ⇒ mỗi đề tài chỉ embedding 1 lần.
# enabled=false ⇒ panel gợi ý tự báo "tạm thời không khả dụng", app vẫn chạy bình thường.
TOPIC_RECOMMENDER_ENABLED=true
TOPIC_RECOMMENDER_URL=http://127.0.0.1:8891
TOPIC_RECOMMENDER_MODEL_TAG=vietnamese-sbert
TOPIC_RECOMMENDER_TOP_K=5
TOPIC_RECOMMENDER_MIN_SCORE=0.0
TOPIC_RECOMMENDER_MAX_CANDIDATES=500
TOPIC_RECOMMENDER_TIMEOUT=15
TOPIC_RECOMMENDER_EMBED_TIMEOUT=120
RECOMMENDER_MODEL_DIR=G:\MyApp\laragon\www\AI-Services\topic-recommender\model
